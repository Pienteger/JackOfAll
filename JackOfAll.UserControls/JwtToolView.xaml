<UserControl x:Class="JackOfAll.UserControls.JwtToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Input -->
        <DockPanel Grid.Row="0">
            <Button Click="OnDecodeClick" DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButton}"
                    Padding="12,4" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Decode" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Content="Clear" Click="OnClearClick" DockPanel.Dock="Right"
                    Padding="12,4" Background="{DynamicResource SurfaceBackground}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource SurfaceBorder}" Margin="8,0,0,0"/>
            <TextBlock Text="JWT Token" Foreground="{DynamicResource TextPrimary}"
                       FontSize="{DynamicResource AppFontSize}" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBox x:Name="TokenInput" Grid.Row="1" Margin="0,8,0,0"
                 Height="80" TextWrapping="Wrap" AcceptsReturn="False"
                 Background="{DynamicResource SurfaceBackground}"
                 Foreground="{DynamicResource TextPrimary}"
                 BorderBrush="{DynamicResource SurfaceBorder}"
                 FontFamily="Cascadia Code,Consolas,Courier New"
                 FontSize="{DynamicResource MonoFontSize}"
                 Padding="8" VerticalScrollBarVisibility="Auto"/>

        <!-- Placeholder -->
        <TextBlock x:Name="PlaceholderText" Grid.Row="2"
                   Text="Paste a JWT token above and click Decode"
                   Foreground="{DynamicResource TextDimmed}" FontStyle="Italic"
                   HorizontalAlignment="Center" Margin="0,40,0,0"/>

        <!-- Decoded output -->
        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                <!-- Status -->
                <Border x:Name="StatusBorder" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusIcon" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </Border>

                <!-- Info -->
                <WrapPanel Margin="0,0,0,12">
                    <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock Foreground="{DynamicResource TextSecondary}">
                            <Run Text="Algorithm: "/><Run x:Name="AlgorithmText" Foreground="{DynamicResource TextPrimary}"/>
                        </TextBlock>
                    </Border>
                    <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock Foreground="{DynamicResource TextSecondary}">
                            <Run Text="Issuer: "/><Run x:Name="IssuerText" Foreground="{DynamicResource TextPrimary}"/>
                        </TextBlock>
                    </Border>
                    <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock Foreground="{DynamicResource TextSecondary}">
                            <Run Text="Subject: "/><Run x:Name="SubjectText" Foreground="{DynamicResource TextPrimary}"/>
                        </TextBlock>
                    </Border>
                </WrapPanel>

                <!-- Header -->
                <TextBlock Text="HEADER" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                    <TextBox x:Name="HeaderText" IsReadOnly="True" TextWrapping="Wrap"
                             Background="Transparent" Foreground="{DynamicResource HeaderColor}" BorderThickness="0"
                             FontFamily="Cascadia Code,Consolas,Courier New"
                             FontSize="{DynamicResource MonoFontSize}"/>
                </Border>

                <!-- Payload -->
                <TextBlock Text="PAYLOAD" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                    <TextBox x:Name="PayloadText" IsReadOnly="True" TextWrapping="Wrap"
                             Background="Transparent" Foreground="{DynamicResource PayloadColor}" BorderThickness="0"
                             FontFamily="Cascadia Code,Consolas,Courier New"
                             FontSize="{DynamicResource MonoFontSize}"/>
                </Border>

                <!-- Signature -->
                <TextBlock Text="SIGNATURE" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="12">
                    <TextBox x:Name="SignatureText" IsReadOnly="True" TextWrapping="Wrap"
                             Background="Transparent" Foreground="{DynamicResource TextDimmed}" BorderThickness="0"
                             FontFamily="Cascadia Code,Consolas,Courier New"
                             FontSize="{DynamicResource MonoFontSize}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Error display -->
        <Border x:Name="ErrorPanel" Grid.Row="2" Visibility="Collapsed"
                Background="{DynamicResource ErrorBackground}"
                BorderBrush="{DynamicResource ErrorBorder}" BorderThickness="1"
                CornerRadius="6" Padding="16" Margin="0,12,0,0"
                VerticalAlignment="Top">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
