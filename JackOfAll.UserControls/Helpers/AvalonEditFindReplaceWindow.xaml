<Window x:Class="JackOfAll.UserControls.Helpers.AvalonEditFindReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find and Replace" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="ToolWindow" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Border Padding="16" Background="{DynamicResource AppBackground}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="ReplaceRow" Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Find" Margin="0,0,10,10"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
            <TextBox x:Name="FindBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,10"
                     MinWidth="220" Padding="7,4" KeyDown="OnFindBoxKeyDown"/>
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Previous" Padding="9,4" Margin="0,0,4,0" Click="OnPreviousClick"/>
                <Button Content="Next" Padding="9,4" IsDefault="True" Click="OnNextClick"/>
            </StackPanel>

            <TextBlock x:Name="ReplaceLabel" Grid.Row="1" Text="Replace" Margin="0,0,10,10"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
            <TextBox x:Name="ReplaceBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,10"
                     Padding="7,4"/>
            <StackPanel x:Name="ReplaceButtons" Grid.Row="1" Grid.Column="2"
                        Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Replace" Padding="9,4" Margin="0,0,4,0" Click="OnReplaceClick"/>
                <Button Content="All" Padding="9,4" Click="OnReplaceAllClick"/>
            </StackPanel>

            <CheckBox x:Name="MatchCaseBox" Grid.Row="2" Grid.Column="1"
                      Content="Match case" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="StatusText" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                       Margin="0,10,0,0" FontSize="11"
                       Foreground="{DynamicResource TextDimmed}"/>
        </Grid>
    </Border>
</Window>
