<Window x:Class="JackOfAll.UserControls.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="360"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Foreground="{DynamicResource TextPrimary}"
                   FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBox x:Name="InputBox" Padding="6,5"
                 FontSize="13"
                 Background="{DynamicResource SurfaceBackground}"
                 Foreground="{DynamicResource TextPrimary}"
                 BorderBrush="{DynamicResource SurfaceBorder}"
                 FontFamily="Cascadia Code,Consolas,Courier New"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="OnCancel" Padding="16,6" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceBackground}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource SurfaceBorder}"/>
            <Button Content="OK" Click="OnOk" Padding="16,6" IsDefault="True"
                    Background="{DynamicResource AccentBrush}" Foreground="White"
                    BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>
