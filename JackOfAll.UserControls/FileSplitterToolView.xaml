<UserControl x:Class="JackOfAll.UserControls.FileSplitterToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <TextBlock Text="FILE SPLITTER" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Source file" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Click="OnBrowseInputClick" Padding="14,6" Margin="8,0,0,0" Content="Browse"/>
                        <TextBox x:Name="InputPathBox" Padding="8,6"/>
                    </DockPanel>

                    <TextBlock Text="Output folder" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Click="OnBrowseOutputClick" Padding="14,6" Margin="8,0,0,0" Content="Browse"/>
                        <TextBox x:Name="OutputFolderBox" Padding="8,6"/>
                    </DockPanel>

                    <WrapPanel Margin="0,0,0,12">
                        <RadioButton x:Name="SplitByLines" Content="lines" IsChecked="True" GroupName="SplitMode"
                                     Foreground="{DynamicResource TextPrimary}" Margin="0,0,16,8"/>
                        <RadioButton x:Name="SplitBySize" Content="size" GroupName="SplitMode"
                                     Foreground="{DynamicResource TextPrimary}" Margin="0,0,16,8"/>
                        <CheckBox x:Name="RepeatHeader" Content="repeat first CSV header"
                                  Foreground="{DynamicResource TextPrimary}" Margin="0,0,16,8"/>
                    </WrapPanel>

                    <WrapPanel>
                        <TextBlock Text="Lines per chunk" Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,6,8"/>
                        <TextBox x:Name="LinesPerChunkBox" Text="10000" Width="90" Padding="6,4" Margin="0,0,18,8"/>
                        <TextBlock Text="Size" Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,6,8"/>
                        <TextBox x:Name="SizeValueBox" Text="50" Width="60" Padding="6,4" Margin="0,0,6,8"/>
                        <ComboBox x:Name="SizeUnitBox" Width="80" SelectedIndex="1" Margin="0,0,18,8">
                            <ComboBoxItem Content="KB"/>
                            <ComboBoxItem Content="MB"/>
                            <ComboBoxItem Content="GB"/>
                        </ComboBox>
                        <TextBlock Text="Name suffix" Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,6,8"/>
                        <TextBox x:Name="SuffixBox" Text="part" Width="80" Padding="6,4" Margin="0,0,0,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Click="OnSplitClick" Style="{StaticResource PrimaryButton}" Padding="18,8" Margin="0,0,8,0" Content="Split File"/>
                <Button Click="OnOpenOutputClick" Padding="18,8" Content="Open Output"/>
            </StackPanel>

            <Border Background="{DynamicResource AppBackground}"
                    BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <TextBlock x:Name="StatusText" Text="CSV/text files split into standalone chunks. Excel .xlsx/.xlsm files export the first worksheet to CSV chunks in lines mode; byte chunks are for recombination, not opening directly." TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}" FontFamily="Cascadia Code,Consolas,Courier New"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>