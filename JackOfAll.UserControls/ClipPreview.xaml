<UserControl x:Class="JackOfAll.UserControls.ClipPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="/JackOfAll.UserControls;component/ClipboardTemplates.xaml"/>
    </UserControl.Resources>
    <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource SurfaceBorder}"
            BorderThickness="1" CornerRadius="8" Padding="16,14">
        <Grid>
            <TextBlock x:Name="EmptyText" Text="Select an item to see all of it."
                       Foreground="{DynamicResource TextDimmed}" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Grid x:Name="Body" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="{Binding KindLabel}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding DetailText}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <!-- Text: selectable, scrolls, monospace when it looks like code -->
                <TextBox Grid.Row="1" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource AppFontSize}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsText}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCodeLike}" Value="True">
                                    <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Courier New"/>
                                    <Setter Property="FontSize" Value="{DynamicResource MonoFontSize}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Image: the picture, then the text Windows read from it -->
                <Grid Grid.Row="1" Style="{StaticResource ForImage}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="6" Background="{DynamicResource TabHoverBackground}" Padding="6">
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" MaxHeight="240"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="TEXT IN THE IMAGE" FontSize="11" FontWeight="SemiBold" Margin="0,14,0,6"
                               Foreground="{DynamicResource TextDimmed}"/>
                    <TextBox Grid.Row="2" Text="{Binding OcrPreview, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource AppFontSize}"/>
                </Grid>

                <!-- Files: each name and folder, dimmed when the file has since been moved or deleted -->
                <ScrollViewer Grid.Row="1" Style="{StaticResource ForFiles}" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FileItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10" Opacity="{Binding Opacity}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Folder}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Text="{Binding StatsText}" FontSize="11" Margin="0,12,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextDimmed}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
