<UserControl x:Class="JackOfAll.UserControls.NotepadToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="New" Click="OnNewClick" Padding="10,4" Margin="4,0,0,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}"/>
                <Button Content="Open" Click="OnOpenClick" Padding="10,4" Margin="4,0,0,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}"/>
                <Button Content="Save" Click="OnSaveClick" Padding="10,4" Margin="4,0,0,0"
                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                <Button Content="Save As" Click="OnSaveAsClick" Padding="10,4" Margin="4,0,0,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}"/>
                <ToggleButton x:Name="PreviewToggle" Content="Preview" Click="OnPreviewToggle"
                              Padding="10,4" Margin="4,0,0,0"
                              Background="{DynamicResource SurfaceBackground}"
                              Foreground="{DynamicResource TextPrimary}"
                              BorderBrush="{DynamicResource SurfaceBorder}"/>
            </StackPanel>
            <TextBlock x:Name="FileTitle" Text="Untitled.md" Foreground="{DynamicResource TextPrimary}"
                       FontSize="{DynamicResource AppFontSize}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Editor / Preview -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Editor -->
            <TextBox x:Name="EditorBox" Grid.Column="0" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="{DynamicResource SurfaceBackground}"
                     Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource SurfaceBorder}"
                     FontFamily="Cascadia Code,Consolas,Courier New"
                     FontSize="{DynamicResource MonoFontSize}"
                     Padding="12" TextChanged="OnTextChanged"/>

            <!-- Splitter (shown when preview is on) -->
            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="6"
                          HorizontalAlignment="Center"
                          Background="{DynamicResource SurfaceBorder}"
                          Margin="4,0,4,0" Visibility="Collapsed"/>

            <!-- Preview -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1">
                <WebBrowser x:Name="PreviewBrowser" Visibility="Collapsed"/>
            </Border>
        </Grid>

        <!-- Status bar -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Border CornerRadius="4" Padding="8,4" Background="{DynamicResource SurfaceBackground}">
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
