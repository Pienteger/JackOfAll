<Window x:Class="JackOfAll.UserControls.ApiEnvironmentManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        Width="720"
        Height="520"
        MinWidth="620"
        MinHeight="420"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}"
        Title="Environment Manager">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="New" Click="OnNewEnvironment" Padding="12,5" Margin="0,0,6,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}"/>
                <Button Content="Delete" Click="OnDeleteEnvironment" Padding="12,5"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Environment" Foreground="{DynamicResource TextSecondary}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="EnvironmentPicker" Width="220" SelectionChanged="OnEnvironmentChanged"
                          Background="{DynamicResource SurfaceBackground}"
                          Foreground="{DynamicResource TextPrimary}"
                          BorderBrush="{DynamicResource SurfaceBorder}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="6">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,8,10,6">
                    <Button Content="+ Add Variable" Click="OnAddVariable" DockPanel.Dock="Right"
                            Padding="10,4"
                            Background="{DynamicResource SurfaceBackground}"
                            Foreground="{DynamicResource TextPrimary}"
                            BorderBrush="{DynamicResource SurfaceBorder}"/>
                    <TextBlock x:Name="VariableHeader" Text="VARIABLES" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid x:Name="VariableGrid" Margin="8" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Background="{DynamicResource SurfaceBackground}"
                          Foreground="{DynamicResource TextPrimary}"
                          BorderThickness="0"
                          RowBackground="{DynamicResource SurfaceBackground}"
                          AlternatingRowBackground="{DynamicResource AppBackground}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Variable" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTemplateColumn Width="48">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="x" Click="OnRemoveVariable" Padding="0" Width="24" Height="22"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource TextDimmed}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextDimmed}" FontSize="12"
                       VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Click="OnCancel" Padding="16,6" Margin="0,0,8,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}"/>
                <Button Content="Save" Click="OnSave" Padding="18,6" IsDefault="True"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>