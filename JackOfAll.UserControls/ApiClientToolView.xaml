<UserControl x:Class="JackOfAll.UserControls.ApiClientToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Environment + Import bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <!-- Environment selector (right side) -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="ENV" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextDimmed}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="EnvPicker" Width="130" FontSize="11"
                          Background="{DynamicResource SurfaceBackground}"
                          Foreground="{DynamicResource TextPrimary}"
                          BorderBrush="{DynamicResource SurfaceBorder}"
                          SelectionChanged="OnEnvChanged"/>
                <Button Click="OnManageEnvClick" Padding="4,2" Margin="4,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextSecondary}" ToolTip="Manage environments">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                </Button>
                <TextBlock x:Name="EnvVarCount" FontSize="10"
                           Foreground="{DynamicResource TextDimmed}"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>

            <!-- Import button (left side) -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Click="OnImportClick" Padding="4,2" Margin="0,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextSecondary}" ToolTip="Import OpenAPI / Swagger">
                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Request tab bar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="RequestTabBar" Orientation="Horizontal"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Main content: sidebar + editor -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                    CornerRadius="6">
                <DockPanel>
                    <!-- Sidebar header -->
                    <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                        <Button Click="OnNewRequestClick" DockPanel.Dock="Right"
                                Style="{StaticResource IconButton}" Content="&#xE710;"
                                ToolTip="New request"/>
                        <TextBlock x:Name="SidebarTitle" Text="REQUESTS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Border DockPanel.Dock="Top" Height="1"
                            Background="{DynamicResource SurfaceBorder}" Margin="8,4"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SavedList"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          Background="{DynamicResource SurfaceBorder}"/>

            <!-- Right: request editor + response -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- URL bar -->
                <Border Grid.Row="0" Padding="8,6,8,6"
                        Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button x:Name="BtnSend" Click="OnSendClick"
                                DockPanel.Dock="Right" Padding="16,6" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButton}" FontSize="13" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="SendButtonText" Text="Send" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnSaveClick"
                                DockPanel.Dock="Right" Padding="10,6" Margin="4,0,0,0"
                                Background="{DynamicResource SurfaceBackground}"
                                Foreground="{DynamicResource TextPrimary}"
                                BorderBrush="{DynamicResource SurfaceBorder}" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Save" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <ComboBox x:Name="MethodPicker" Width="90" Margin="0,0,8,0"
                                  FontSize="13" FontWeight="SemiBold"
                                  Background="{DynamicResource SurfaceBackground}"
                                  Foreground="{DynamicResource TextPrimary}"
                                  BorderBrush="{DynamicResource SurfaceBorder}">
                            <ComboBoxItem Content="GET" IsSelected="True"/>
                            <ComboBoxItem Content="POST"/>
                            <ComboBoxItem Content="PUT"/>
                            <ComboBoxItem Content="PATCH"/>
                            <ComboBoxItem Content="DELETE"/>
                            <ComboBoxItem Content="HEAD"/>
                            <ComboBoxItem Content="OPTIONS"/>
                        </ComboBox>
                        <TextBox x:Name="UrlBox" Padding="6,5"
                                 FontSize="13"
                                 Background="{DynamicResource AppBackground}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource SurfaceBorder}"
                                 FontFamily="Cascadia Code,Consolas,Courier New"
                                 VerticalContentAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Request tabs: Params, Headers, Body, Auth -->
                <TabControl Grid.Row="1" x:Name="RequestTabs"
                            Background="{DynamicResource AppBackground}"
                            BorderThickness="0" Padding="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource InnerTabItem}"/>
                    </TabControl.Resources>

                    <TabItem Header="Params">
                        <DockPanel Margin="8">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button Content="+ Add" Click="OnAddParamClick" DockPanel.Dock="Right"
                                        Padding="8,3" Background="{DynamicResource SurfaceBackground}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"/>
                                <TextBlock Text="QUERY PARAMETERS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ParamsList"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Headers">
                        <DockPanel Margin="8">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button Content="+ Add" Click="OnAddHeaderClick" DockPanel.Dock="Right"
                                        Padding="8,3" Background="{DynamicResource SurfaceBackground}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"/>
                                <TextBlock Text="REQUEST HEADERS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="HeadersList"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Body">
                        <DockPanel Margin="8">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="BodyNone" Content="none" GroupName="BodyType"
                                             IsChecked="True" Margin="0,0,16,0" FontSize="12"
                                             Foreground="{DynamicResource TextPrimary}"
                                             Click="OnBodyTypeChanged"/>
                                <RadioButton x:Name="BodyFormData" Content="form-data" GroupName="BodyType"
                                             Margin="0,0,16,0" FontSize="12"
                                             Foreground="{DynamicResource TextPrimary}"
                                             Click="OnBodyTypeChanged"/>
                                <RadioButton x:Name="BodyUrlEncoded" Content="x-www-form-urlencoded" GroupName="BodyType"
                                             Margin="0,0,16,0" FontSize="12"
                                             Foreground="{DynamicResource TextPrimary}"
                                             Click="OnBodyTypeChanged"/>
                                <RadioButton x:Name="BodyRaw" Content="raw" GroupName="BodyType"
                                             Margin="0,0,16,0" FontSize="12"
                                             Foreground="{DynamicResource TextPrimary}"
                                             Click="OnBodyTypeChanged"/>
                            </StackPanel>

                            <TextBlock x:Name="BodyNonePanel"
                                       Text="This request does not have a body."
                                       Foreground="{DynamicResource TextDimmed}" FontSize="12"
                                       Margin="0,12,0,0"/>

                            <DockPanel x:Name="BodyFormPanel" Visibility="Collapsed">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button Content="+ Add" Click="OnAddFormDataClick" DockPanel.Dock="Right"
                                            Padding="8,3" Background="{DynamicResource SurfaceBackground}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"/>
                                    <TextBlock x:Name="FormDataLabel" Text="FORM DATA" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="FormDataList"/>
                                </ScrollViewer>
                            </DockPanel>

                            <DockPanel x:Name="BodyRawPanel" Visibility="Collapsed">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Content-Type:" Foreground="{DynamicResource TextSecondary}"
                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="RawContentType" Width="180" FontSize="11"
                                              Background="{DynamicResource SurfaceBackground}"
                                              Foreground="{DynamicResource TextPrimary}"
                                              BorderBrush="{DynamicResource SurfaceBorder}">
                                        <ComboBoxItem Content="application/json" IsSelected="True"/>
                                        <ComboBoxItem Content="text/plain"/>
                                        <ComboBoxItem Content="application/xml"/>
                                        <ComboBoxItem Content="text/html"/>
                                        <ComboBoxItem Content="application/javascript"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBox x:Name="BodyBox" AcceptsReturn="True" AcceptsTab="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Background="{DynamicResource SurfaceBackground}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         BorderBrush="{DynamicResource SurfaceBorder}"
                                         FontFamily="Cascadia Code,Consolas,Courier New"
                                         FontSize="{DynamicResource MonoFontSize}"
                                         Padding="8"/>
                            </DockPanel>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Auth">
                        <StackPanel Margin="8">
                            <TextBlock Text="AUTHORIZATION" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Type:" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                <ComboBox x:Name="AuthType" Width="150" FontSize="12"
                                          Background="{DynamicResource SurfaceBackground}"
                                          Foreground="{DynamicResource TextPrimary}"
                                          BorderBrush="{DynamicResource SurfaceBorder}"
                                          SelectionChanged="OnAuthTypeChanged">
                                    <ComboBoxItem Content="None" IsSelected="True"/>
                                    <ComboBoxItem Content="Bearer"/>
                                    <ComboBoxItem Content="Basic"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="AuthValuePanel" Visibility="Collapsed">
                                <TextBlock x:Name="AuthHint" Text="Token:"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="AuthValueBox" Padding="6,4"
                                         Background="{DynamicResource SurfaceBackground}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         BorderBrush="{DynamicResource SurfaceBorder}"
                                         FontFamily="Cascadia Code,Consolas,Courier New"
                                         FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- Splitter -->
                <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource SurfaceBorder}"
                              ResizeDirection="Rows"/>

                <!-- Response section -->
                <DockPanel Grid.Row="3">
                    <Border DockPanel.Dock="Top" Padding="8,6"
                            Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button Click="OnCopyResponseClick" DockPanel.Dock="Right"
                                    Padding="8,3"
                                    Background="{DynamicResource SurfaceBackground}"
                                    Foreground="{DynamicResource TextPrimary}"
                                    BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Copy" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RESPONSE" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border x:Name="StatusBadge" CornerRadius="3" Padding="8,2"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock x:Name="TimingText" FontSize="11"
                                           Foreground="{DynamicResource TextDimmed}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TabControl x:Name="ResponseTabs"
                                Background="{DynamicResource AppBackground}"
                                BorderThickness="0" Padding="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem" BasedOn="{StaticResource InnerTabItem}"/>
                        </TabControl.Resources>

                        <TabItem Header="Body">
                            <TextBox x:Name="ResponseBody" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Background="{DynamicResource AppBackground}"
                                     Foreground="{DynamicResource TextPrimary}"
                                     BorderThickness="0"
                                     FontFamily="Cascadia Code,Consolas,Courier New"
                                     FontSize="{DynamicResource MonoFontSize}"
                                     Padding="8"
                                     Text="Send a request to see the response."/>
                        </TabItem>
                        <TabItem Header="Headers">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                <StackPanel x:Name="ResponseHeadersList" Margin="8"/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Extract">
                            <DockPanel Margin="8">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button Content="+ Add Rule" Click="OnAddExtractionRule" DockPanel.Dock="Right"
                                            Padding="8,3" Background="{DynamicResource SurfaceBackground}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"/>
                                    <Button Click="OnRunExtraction" DockPanel.Dock="Right"
                                            Padding="8,3" Margin="0,0,6,0"
                                            Background="{DynamicResource SurfaceBackground}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"
                                            ToolTip="Re-run extraction on last response">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="Re-run" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="EXTRACTION RULES" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Auto-runs after each response. Use {{varName}} in URL, headers, body, auth."
                                           Foreground="{DynamicResource TextDimmed}" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ExtractionRulesList"/>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Vars">
                            <DockPanel Margin="8">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button Click="OnAddManualVar" DockPanel.Dock="Right"
                                            Padding="8,3" Background="{DynamicResource SurfaceBackground}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="Add" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="VarsTabLabel" Text="ENVIRONMENT VARIABLES" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="VarsList"/>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="History">
                            <DockPanel Margin="8">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button x:Name="BtnClearHistory" Click="OnClearRequestHistoryClick"
                                            DockPanel.Dock="Right" Padding="8,3"
                                            Background="{DynamicResource SurfaceBackground}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="Clear" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnFillFromHistory" Click="OnFillFromHistoryClick"
                                            DockPanel.Dock="Right" Padding="8,3" Margin="0,0,6,0"
                                            Background="{DynamicResource SurfaceBackground}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="Fill request" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="HistoryTabLabel" Text="REQUEST HISTORY"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="HistoryEntryList"/>
                                    </ScrollViewer>
                                    <GridSplitter Grid.Column="1" Width="3"
                                                  Background="{DynamicResource SurfaceBorder}"/>
                                    <DockPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock x:Name="HistoryDetailLabel" DockPanel.Dock="Top"
                                                   Text="Select an entry to view details."
                                                   Foreground="{DynamicResource TextDimmed}"
                                                   FontSize="12" Margin="0,0,0,8"/>
                                        <TabControl x:Name="HistoryDetailTabs" Visibility="Collapsed"
                                                    Background="{DynamicResource AppBackground}"
                                                    BorderThickness="0">
                                            <TabControl.Resources>
                                                <Style TargetType="TabItem"
                                                       BasedOn="{StaticResource InnerTabItem}"/>
                                            </TabControl.Resources>
                                            <TabItem Header="Response">
                                                <TextBox x:Name="HistoryResponseBody" IsReadOnly="True"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Background="{DynamicResource AppBackground}"
                                                         Foreground="{DynamicResource TextPrimary}"
                                                         BorderThickness="0"
                                                         FontFamily="Cascadia Code,Consolas,Courier New"
                                                         FontSize="{DynamicResource MonoFontSize}"
                                                         Padding="8"/>
                                            </TabItem>
                                            <TabItem Header="Request">
                                                <TextBox x:Name="HistoryRequestBody" IsReadOnly="True"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Background="{DynamicResource AppBackground}"
                                                         Foreground="{DynamicResource TextPrimary}"
                                                         BorderThickness="0"
                                                         FontFamily="Cascadia Code,Consolas,Courier New"
                                                         FontSize="{DynamicResource MonoFontSize}"
                                                         Padding="8"/>
                                            </TabItem>
                                        </TabControl>
                                    </DockPanel>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
