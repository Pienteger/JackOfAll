<UserControl x:Class="JackOfAll.UserControls.ApiClientToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="120"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left sidebar: saved + history -->
        <DockPanel Grid.Column="0" Background="{DynamicResource SurfaceBackground}">
            <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                <Button Content="+" Click="OnNewRequestClick" DockPanel.Dock="Right"
                        Width="24" Height="24" Padding="0"
                        Background="{DynamicResource AccentBrush}" Foreground="White"
                        BorderThickness="0" FontSize="14" FontWeight="Bold"
                        ToolTip="New request"/>
                <TextBlock Text="REQUESTS" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            </DockPanel>

            <Border DockPanel.Dock="Top" Height="1"
                    Background="{DynamicResource SurfaceBorder}" Margin="8,4"/>

            <!-- Saved collection -->
            <DockPanel DockPanel.Dock="Top">
                <TextBlock Text="SAVED" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextDimmed}" Margin="8,6,8,2"/>
            </DockPanel>
            <StackPanel x:Name="SavedList" DockPanel.Dock="Top"/>

            <Border DockPanel.Dock="Top" Height="1"
                    Background="{DynamicResource SurfaceBorder}" Margin="8,4"/>

            <!-- History -->
            <DockPanel DockPanel.Dock="Top">
                <Button Content="Clear" Click="OnClearHistoryClick" DockPanel.Dock="Right"
                        Padding="4,1" Margin="0,4,8,2" FontSize="10"
                        Background="Transparent" Foreground="{DynamicResource TextDimmed}"
                        BorderThickness="0"/>
                <TextBlock Text="HISTORY" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextDimmed}" Margin="8,6,8,2"/>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="HistoryList"/>
            </ScrollViewer>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                      Background="{DynamicResource SurfaceBorder}"/>

        <!-- Right: request + response -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Environment bar + URL bar -->
            <Border Grid.Row="0" Padding="8,6,8,6"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <!-- Environment selector -->
                    <DockPanel Margin="0,0,0,6">
                        <Button Content="Manage" Click="OnManageEnvClick" DockPanel.Dock="Right"
                                Padding="6,2" Margin="4,0,0,0" FontSize="10"
                                Background="{DynamicResource SurfaceBackground}"
                                Foreground="{DynamicResource TextSecondary}"
                                BorderBrush="{DynamicResource SurfaceBorder}"/>
                        <TextBlock Text="ENV" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDimmed}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="EnvPicker" Width="140" FontSize="11"
                                  Background="{DynamicResource SurfaceBackground}"
                                  Foreground="{DynamicResource TextPrimary}"
                                  BorderBrush="{DynamicResource SurfaceBorder}"
                                  SelectionChanged="OnEnvChanged"/>
                        <TextBlock x:Name="EnvVarCount" FontSize="10"
                                   Foreground="{DynamicResource TextDimmed}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </DockPanel>

                    <!-- URL row -->
                    <DockPanel>
                        <Button x:Name="BtnSend" Content="Send" Click="OnSendClick"
                                DockPanel.Dock="Right" Padding="16,6" Margin="8,0,0,0"
                                Background="{DynamicResource AccentBrush}" Foreground="White"
                                BorderThickness="0" FontSize="13" FontWeight="SemiBold"/>
                        <Button Content="Save" Click="OnSaveClick"
                                DockPanel.Dock="Right" Padding="10,6" Margin="4,0,0,0"
                                Background="{DynamicResource SurfaceBackground}"
                                Foreground="{DynamicResource TextPrimary}"
                                BorderBrush="{DynamicResource SurfaceBorder}" FontSize="12"/>
                        <ComboBox x:Name="MethodPicker" Width="90" Margin="0,0,8,0"
                                  FontSize="13" FontWeight="SemiBold"
                                  Background="{DynamicResource SurfaceBackground}"
                                  Foreground="{DynamicResource TextPrimary}"
                                  BorderBrush="{DynamicResource SurfaceBorder}">
                            <ComboBoxItem Content="GET" IsSelected="True"/>
                            <ComboBoxItem Content="POST"/>
                            <ComboBoxItem Content="PUT"/>
                            <ComboBoxItem Content="PATCH"/>
                            <ComboBoxItem Content="DELETE"/>
                            <ComboBoxItem Content="HEAD"/>
                            <ComboBoxItem Content="OPTIONS"/>
                        </ComboBox>
                        <TextBox x:Name="UrlBox" Padding="6,5"
                                 FontSize="13"
                                 Background="{DynamicResource AppBackground}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource SurfaceBorder}"
                                 FontFamily="Cascadia Code,Consolas,Courier New"
                                 VerticalContentAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Request tabs: Headers, Body, Params, Auth -->
            <TabControl Grid.Row="1" x:Name="RequestTabs"
                        Background="{DynamicResource AppBackground}"
                        BorderThickness="0" Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="0,0,0,0">
                                        <ContentPresenter ContentSource="Header"
                                                          HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- Params tab -->
                <TabItem Header="Params">
                    <DockPanel Margin="8">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button Content="+ Add" Click="OnAddParamClick" DockPanel.Dock="Right"
                                    Padding="8,3" Background="{DynamicResource SurfaceBackground}"
                                    Foreground="{DynamicResource TextPrimary}"
                                    BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"/>
                            <TextBlock Text="QUERY PARAMETERS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ParamsList"/>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- Headers tab -->
                <TabItem Header="Headers">
                    <DockPanel Margin="8">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button Content="+ Add" Click="OnAddHeaderClick" DockPanel.Dock="Right"
                                    Padding="8,3" Background="{DynamicResource SurfaceBackground}"
                                    Foreground="{DynamicResource TextPrimary}"
                                    BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"/>
                            <TextBlock Text="REQUEST HEADERS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="HeadersList"/>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- Body tab -->
                <TabItem Header="Body">
                    <DockPanel Margin="8">
                        <!-- Body type selector -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="BodyNone" Content="none" GroupName="BodyType"
                                         IsChecked="True" Margin="0,0,16,0" FontSize="12"
                                         Foreground="{DynamicResource TextPrimary}"
                                         Click="OnBodyTypeChanged"/>
                            <RadioButton x:Name="BodyFormData" Content="form-data" GroupName="BodyType"
                                         Margin="0,0,16,0" FontSize="12"
                                         Foreground="{DynamicResource TextPrimary}"
                                         Click="OnBodyTypeChanged"/>
                            <RadioButton x:Name="BodyUrlEncoded" Content="x-www-form-urlencoded" GroupName="BodyType"
                                         Margin="0,0,16,0" FontSize="12"
                                         Foreground="{DynamicResource TextPrimary}"
                                         Click="OnBodyTypeChanged"/>
                            <RadioButton x:Name="BodyRaw" Content="raw" GroupName="BodyType"
                                         Margin="0,0,16,0" FontSize="12"
                                         Foreground="{DynamicResource TextPrimary}"
                                         Click="OnBodyTypeChanged"/>
                        </StackPanel>

                        <!-- None message -->
                        <TextBlock x:Name="BodyNonePanel"
                                   Text="This request does not have a body."
                                   Foreground="{DynamicResource TextDimmed}" FontSize="12"
                                   Margin="0,12,0,0"/>

                        <!-- Form data (form-data + x-www-form-urlencoded) -->
                        <DockPanel x:Name="BodyFormPanel" Visibility="Collapsed">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button Content="+ Add" Click="OnAddFormDataClick" DockPanel.Dock="Right"
                                        Padding="8,3" Background="{DynamicResource SurfaceBackground}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"/>
                                <TextBlock x:Name="FormDataLabel" Text="FORM DATA" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="FormDataList"/>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Raw body -->
                        <DockPanel x:Name="BodyRawPanel" Visibility="Collapsed">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Content-Type:" Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="RawContentType" Width="180" FontSize="11"
                                          Background="{DynamicResource SurfaceBackground}"
                                          Foreground="{DynamicResource TextPrimary}"
                                          BorderBrush="{DynamicResource SurfaceBorder}">
                                    <ComboBoxItem Content="application/json" IsSelected="True"/>
                                    <ComboBoxItem Content="text/plain"/>
                                    <ComboBoxItem Content="application/xml"/>
                                    <ComboBoxItem Content="text/html"/>
                                    <ComboBoxItem Content="application/javascript"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBox x:Name="BodyBox" AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource SurfaceBackground}"
                                     Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource SurfaceBorder}"
                                     FontFamily="Cascadia Code,Consolas,Courier New"
                                     FontSize="{DynamicResource MonoFontSize}"
                                     Padding="8"/>
                        </DockPanel>
                    </DockPanel>
                </TabItem>

                <!-- Auth tab -->
                <TabItem Header="Auth">
                    <StackPanel Margin="8">
                        <TextBlock Text="AUTHORIZATION" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Type:" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                            <ComboBox x:Name="AuthType" Width="150" FontSize="12"
                                      Background="{DynamicResource SurfaceBackground}"
                                      Foreground="{DynamicResource TextPrimary}"
                                      BorderBrush="{DynamicResource SurfaceBorder}"
                                      SelectionChanged="OnAuthTypeChanged">
                                <ComboBoxItem Content="None" IsSelected="True"/>
                                <ComboBoxItem Content="Bearer"/>
                                <ComboBoxItem Content="Basic"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="AuthValuePanel" Visibility="Collapsed">
                            <TextBlock x:Name="AuthHint" Text="Token:"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="AuthValueBox" Padding="6,4"
                                     Background="{DynamicResource SurfaceBackground}"
                                     Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource SurfaceBorder}"
                                     FontFamily="Cascadia Code,Consolas,Courier New"
                                     FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Splitter between request and response -->
            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource SurfaceBorder}"
                          ResizeDirection="Rows"/>

            <!-- Response section -->
            <DockPanel Grid.Row="3">
                <Border DockPanel.Dock="Top" Padding="8,6"
                        Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button Content="Copy Body" Click="OnCopyResponseClick" DockPanel.Dock="Right"
                                Padding="8,3"
                                Background="{DynamicResource SurfaceBackground}"
                                Foreground="{DynamicResource TextPrimary}"
                                BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RESPONSE" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border x:Name="StatusBadge" CornerRadius="3" Padding="8,2"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="TimingText" FontSize="11"
                                       Foreground="{DynamicResource TextDimmed}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TabControl x:Name="ResponseTabs"
                            Background="{DynamicResource AppBackground}"
                            BorderThickness="0" Padding="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="12,6"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="0,0,0,0">
                                            <ContentPresenter ContentSource="Header"
                                                              HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="Body">
                        <TextBox x:Name="ResponseBody" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="{DynamicResource AppBackground}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 BorderThickness="0"
                                 FontFamily="Cascadia Code,Consolas,Courier New"
                                 FontSize="{DynamicResource MonoFontSize}"
                                 Padding="8"
                                 Text="Send a request to see the response."/>
                    </TabItem>
                    <TabItem Header="Headers">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                            <StackPanel x:Name="ResponseHeadersList" Margin="8"/>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Extract variables from response -->
                    <TabItem Header="Extract">
                        <DockPanel Margin="8">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button Content="+ Add Rule" Click="OnAddExtractionRule" DockPanel.Dock="Right"
                                        Padding="8,3" Background="{DynamicResource SurfaceBackground}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"/>
                                <Button Content="Re-run" Click="OnRunExtraction" DockPanel.Dock="Right"
                                        Padding="8,3" Margin="0,0,6,0"
                                        Background="{DynamicResource SurfaceBackground}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"
                                        ToolTip="Manually re-run extraction on the last response"/>
                                <TextBlock Text="EXTRACTION RULES" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Runs automatically after each response. Use {{varName}} anywhere: URL, headers, body, auth. Source: jsonpath ($.data.token), regex (capture group), or header name."
                                       Foreground="{DynamicResource TextDimmed}" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ExtractionRulesList"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- Current environment variables -->
                    <TabItem Header="Vars">
                        <DockPanel Margin="8">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button Content="+ Add" Click="OnAddManualVar" DockPanel.Dock="Right"
                                        Padding="8,3" Background="{DynamicResource SurfaceBackground}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"/>
                                <TextBlock x:Name="VarsTabLabel" Text="ENVIRONMENT VARIABLES" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="VarsList"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
