<UserControl x:Class="JackOfAll.UserControls.NewTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24,0,24">
        <StackPanel>
            <TextBlock Text="Pick a tool" FontSize="26" FontWeight="Light"
                       Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Your dev Swiss Army knife" FontSize="13"
                       Foreground="{DynamicResource TextDimmed}" HorizontalAlignment="Center" Margin="0,0,0,32"/>
            <ItemsControl x:Name="ToolGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" MaxWidth="700"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="140" Height="130" Margin="8"
                                Click="OnToolClick" Tag="{Binding ToolId}"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{DynamicResource SurfaceBackground}"
                                            BorderBrush="{DynamicResource SurfaceBorder}"
                                            BorderThickness="1" CornerRadius="10"
                                            SnapsToDevicePixels="True" ClipToBounds="True">
                                        <Border.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.12" Color="Black"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="75"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" CornerRadius="9,9,0,0"
                                                    Background="{Binding AccentColor}">
                                                <Viewbox Width="28" Height="28"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{Binding IconGlyph}" Fill="White"
                                                          Width="24" Height="24" Stretch="Uniform"/>
                                                </Viewbox>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="12" FontWeight="Medium"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextWrapping="Wrap" TextAlignment="Center" Margin="8,0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="-4"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="Bd" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect ShadowDepth="6" BlurRadius="18" Opacity="0.22" Color="Black"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
