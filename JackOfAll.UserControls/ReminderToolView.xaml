<UserControl x:Class="JackOfAll.UserControls.ReminderToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Add new reminder -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource SurfaceBorder}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button Click="OnAddClick" DockPanel.Dock="Right"
                            Padding="16,6" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Add Reminder" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBox x:Name="NewReminderText" AcceptsReturn="False"
                             KeyDown="OnNewReminderKeyDown"
                             Background="{DynamicResource AppBackground}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource SurfaceBorder}"
                             FontSize="{DynamicResource AppFontSize}"
                             Padding="8,6" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Due:" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <TextBox x:Name="DueDate" Width="160" Padding="4,4"
                             Background="{DynamicResource AppBackground}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource SurfaceBorder}" FontSize="12"/>
                    <TextBlock Text="(optional, e.g. 2024-12-25 14:00)" FontSize="11"
                               Foreground="{DynamicResource TextDimmed}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Filter -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Show All" Click="OnShowAll" Padding="8,4" Margin="4,0,0,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"/>
                <Button Content="Active Only" Click="OnShowActive" Padding="8,4" Margin="4,0,0,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"/>
                <Button Content="Clear Completed" Click="OnClearCompleted" Padding="8,4" Margin="4,0,0,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"/>
            </StackPanel>
            <TextBlock x:Name="CountText" Foreground="{DynamicResource TextSecondary}"
                       FontSize="12" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Reminder List -->
        <TextBlock Grid.Row="2" Text="No reminders yet"
                   Foreground="{DynamicResource TextDimmed}" FontStyle="Italic"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
        <ListBox x:Name="ReminderList" Grid.Row="2"
                 Background="{DynamicResource AppBackground}"
                 BorderBrush="{DynamicResource SurfaceBorder}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="2,2,2,2">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Done" Click="OnToggleComplete" Tag="{Binding Id}"
                                        Padding="8,2" Margin="4,0,0,0"
                                        Background="{DynamicResource SurfaceBackground}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"/>
                                <Button Content="Delete" Click="OnDeleteClick" Tag="{Binding Id}"
                                        Padding="8,2" Margin="4,0,0,0"
                                        Background="{DynamicResource SurfaceBackground}"
                                        Foreground="{DynamicResource DangerBrush}"
                                        BorderBrush="{DynamicResource SurfaceBorder}" FontSize="11"/>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                      Click="OnCheckboxClick" Tag="{Binding Id}"
                                      VerticalAlignment="Top" Margin="0,2,8,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="{DynamicResource AppFontSize}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='Created: {0:g}'}"
                                               Foreground="{DynamicResource TextDimmed}" FontSize="11"/>
                                    <TextBlock Text="{Binding DueAt, StringFormat='  Due: {0:g}'}"
                                               Foreground="{DynamicResource TextSecondary}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DueAt}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
