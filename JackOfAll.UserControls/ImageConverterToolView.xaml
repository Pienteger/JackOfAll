<UserControl x:Class="JackOfAll.UserControls.ImageConverterToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <TextBlock Text="IMAGE CONVERTER" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Source image" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Click="OnBrowseInputClick" Padding="14,6" Margin="8,0,0,0" Content="Browse"/>
                            <TextBox x:Name="InputPathBox" Padding="8,6"/>
                        </DockPanel>

                        <TextBlock Text="Output file" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Click="OnBrowseOutputClick" Padding="14,6" Margin="8,0,0,0" Content="Save As"/>
                            <TextBox x:Name="OutputPathBox" Padding="8,6"/>
                        </DockPanel>

                        <WrapPanel>
                            <TextBlock Text="Format" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,8"/>
                            <ComboBox x:Name="FormatBox" Width="95" SelectedIndex="0" SelectionChanged="OnFormatChanged" Margin="0,0,18,8">
                                <ComboBoxItem Content="png"/>
                                <ComboBoxItem Content="jpg"/>
                                <ComboBoxItem Content="bmp"/>
                                <ComboBoxItem Content="gif"/>
                                <ComboBoxItem Content="tiff"/>
                                <ComboBoxItem Content="ico"/>
                            </ComboBox>
                            <TextBlock Text="JPEG quality" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,8"/>
                            <TextBox x:Name="QualityBox" Text="90" Width="50" Padding="6,4" Margin="0,0,18,8"/>
                            <TextBlock Text="ICO size" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,8"/>
                            <ComboBox x:Name="IconSizeBox" Width="75" SelectedIndex="2" Margin="0,0,0,8">
                                <ComboBoxItem Content="16"/>
                                <ComboBoxItem Content="32"/>
                                <ComboBoxItem Content="64"/>
                                <ComboBoxItem Content="256"/>
                            </ComboBox>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Column="2" Background="{DynamicResource AppBackground}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="8">
                        <Image x:Name="PreviewImage" Stretch="Uniform" Height="180"/>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Click="OnConvertClick" Style="{StaticResource PrimaryButton}" Padding="18,8" Margin="0,0,8,0" Content="Convert"/>
                <Button Click="OnOpenOutputClick" Padding="18,8" Content="Open Output"/>
            </StackPanel>

            <Border Background="{DynamicResource AppBackground}"
                    BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <TextBlock x:Name="StatusText" Text="Uses Windows/WPF imaging codecs. HEIC works when the Windows HEIF codec is installed." TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}" FontFamily="Cascadia Code,Consolas,Courier New"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>