<UserControl x:Class="JackOfAll.UserControls.FerryToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" AllowDrop="True"
             DragOver="OnDragOver" Drop="OnDrop" PreviewKeyDown="OnPreviewKeyDown"
             d:DesignHeight="640" d:DesignWidth="980">
    <UserControl.Resources>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Connect card: QR code, link and network -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource SurfaceBorder}"
                BorderThickness="1" CornerRadius="8" Padding="18,16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="11" Margin="0,14,0,0"
                           Foreground="{DynamicResource TextDimmed}"
                           Text="The phone has to be on the same Wi-Fi. If the page won't load, allow JackOfAll for private networks in Windows Firewall."/>
                <StackPanel>
                    <TextBlock Text="Scan to connect" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Point your phone's camera at the code, then open the link." TextWrapping="Wrap" FontSize="12"
                               Margin="0,2,0,14" Foreground="{DynamicResource TextSecondary}"/>
                    <Border Background="White" CornerRadius="8" Padding="6" Width="236" Height="236">
                        <Grid>
                            <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform"/>
                            <TextBlock x:Name="QrMessage" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#555" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="UrlText" HorizontalAlignment="Center" Margin="0,10,0,0" Cursor="Hand"
                               FontFamily="Cascadia Code,Consolas,Courier New" FontSize="12" ToolTip="Click to copy the link"
                               Foreground="{DynamicResource AccentBrush}" MouseLeftButtonUp="OnUrlClick"/>

                    <TextBlock Text="NETWORK" FontSize="11" FontWeight="SemiBold" Margin="0,18,0,6" Foreground="{DynamicResource TextDimmed}"/>
                    <ComboBox x:Name="NetBox" SelectionChanged="OnNetworkChanged"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnCopyLink" Grid.Column="0" Content="Copy link" Padding="10,6" Click="OnCopyLinkClick"
                                Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}"
                                BorderBrush="{DynamicResource SurfaceBorder}"/>
                        <Button Grid.Column="2" Content="New link" Padding="10,6" Click="OnNewLinkClick"
                                ToolTip="Phones with the current page open lose access until they scan again"
                                Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}"
                                BorderBrush="{DynamicResource SurfaceBorder}"/>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Feed and sending -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Ferry" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="Send files and text between your phone and this PC over Wi-Fi" FontSize="12" VerticalAlignment="Center"
                               Margin="12,2,0,0" Foreground="{DynamicResource TextDimmed}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>

            <ListView x:Name="Feed" Grid.Row="1" Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      MouseDoubleClick="OnFeedDoubleClick" PreviewKeyDown="OnFeedKeyDown">
                <ListView.ContextMenu>
                    <ContextMenu Opened="OnMenuOpened">
                        <MenuItem x:Name="MenuOpen" Header="Open" Click="OnMenuOpen"/>
                        <MenuItem x:Name="MenuShowFolder" Header="Show in folder" Click="OnMenuShowFolder"/>
                        <MenuItem x:Name="MenuCopy" Header="Copy" Click="OnMenuCopy"/>
                        <Separator/>
                        <MenuItem x:Name="MenuRemove" Header="Remove from list" InputGestureText="Del" Click="OnMenuRemove"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource SurfaceBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBackground}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Top" ClipToBounds="True"
                                    Background="{DynamicResource TabHoverBackground}">
                                <Grid>
                                    <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="40"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Direction}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ToPhone}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" Margin="12,2,0,0" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextDimmed}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Saved on phone">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessText}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border x:Name="EmptyState" Grid.Row="1" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="8"
                    IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="Nothing shared yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondary}"
                               Text="Drop files or folders here to send them to your phone. Whatever the phone sends shows up here and in the received folder."/>
                </StackPanel>
            </Border>

            <!-- Text to the phone -->
            <Border Grid.Row="2" Margin="0,12,0,0" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8">
                <DockPanel>
                    <Button x:Name="BtnSendText" DockPanel.Dock="Right" Content="Send text" Padding="14,6" Margin="12,0,0,0"
                            VerticalAlignment="Bottom" Style="{StaticResource PrimaryButton}" Click="OnSendTextClick"/>
                    <Grid>
                        <TextBox x:Name="Composer" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="140"
                                 VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}" TextChanged="OnComposerChanged" PreviewKeyDown="OnComposerKeyDown"/>
                        <TextBlock x:Name="ComposerHint" Text="Type or paste text for your phone  ·  Ctrl+Enter sends" Margin="4,4,0,0"
                                   IsHitTestVisible="False" Foreground="{DynamicResource TextDimmed}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Click="OnSendFilesClick" Padding="12,6" ToolTip="Ctrl+O"
                        Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource SurfaceBorder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Send files…" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnSendClipboardClick" Padding="12,6" Margin="8,0,0,0" ToolTip="Ctrl+V outside the text box"
                        Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource SurfaceBorder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF0E3;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Send clipboard" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <DockPanel Grid.Row="4" Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Margin="16,0,0,0"><Hyperlink Click="OnOpenFolderClick">Open received folder</Hyperlink></TextBlock>
                    <TextBlock Margin="12,0,0,0"><Hyperlink Click="OnChangeFolderClick">Change…</Hyperlink></TextBlock>
                    <TextBlock Margin="16,0,0,0"><Hyperlink Click="OnClearClick">Clear list</Hyperlink></TextBlock>
                </StackPanel>
                <CheckBox x:Name="AutoCopyCheck" Content="Copy text from the phone to the clipboard"
                          Checked="OnAutoCopyChanged" Unchecked="OnAutoCopyChanged"/>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
