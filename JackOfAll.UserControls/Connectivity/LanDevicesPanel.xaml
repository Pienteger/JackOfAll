<UserControl x:Class="JackOfAll.UserControls.Connectivity.LanDevicesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:JackOfAll.UserControls.Helpers">
    <UserControl.Resources>
        <ResourceDictionary Source="ConnectivityStyles.xaml"/>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnScan" Click="OnScanClick" Style="{StaticResource PrimaryButton}" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ScanLabel" Text="Scan network" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnCancel" Click="OnCancelClick" Style="{StaticResource DangerButton}" Padding="10,5" Margin="6,0,0,0"
                            Visibility="Collapsed" Content="Cancel"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="DEVICES ON YOUR NETWORK" Style="{StaticResource SectionLabel}"/>
                    <TextBlock x:Name="SubnetText" Style="{StaticResource Body}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <h:LevelBar x:Name="Progress" DockPanel.Dock="Top" Height="4" Margin="0,0,0,10" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"/>

            <TextBlock x:Name="Footnote" DockPanel.Dock="Bottom" Style="{StaticResource Body}" FontSize="11" Foreground="{DynamicResource TextDimmed}"
                       Margin="0,10,0,0"
                       Text="Pings every address on your subnet, then reads this PC's ARP table, which also catches devices that ignore ping. A private MAC means the device uses a random address for privacy (most phones do), so the maker can't be told from it."/>

            <Grid>
                <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                          Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}"
                          BorderBrush="{DynamicResource SurfaceBorder}" RowBackground="{DynamicResource SurfaceBackground}"
                          AlternatingRowBackground="{DynamicResource AppBackground}" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource SurfaceBorder}" HeadersVisibility="Column">
                    <DataGrid.Resources>
                        <Style x:Key="Mono" TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Courier New"/>
                            <Setter Property="FontSize" Value="{DynamicResource MonoFontSize}"/>
                            <Setter Property="Padding" Value="6,4"/>
                        </Style>
                        <Style x:Key="Plain" TargetType="TextBlock">
                            <Setter Property="Padding" Value="6,4"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IP address" Binding="{Binding Ip}" Width="130" ElementStyle="{StaticResource Mono}" SortMemberPath="SortKey"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Plain}"/>
                        <DataGridTextColumn Header="MAC address" Binding="{Binding Mac}" Width="150" ElementStyle="{StaticResource Mono}"/>
                        <DataGridTextColumn Header="Ping" Binding="{Binding PingText}" Width="70" ElementStyle="{StaticResource Mono}" SortMemberPath="PingSort"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="220" ElementStyle="{StaticResource Plain}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText" Text="Scan to see what's connected to your network." Foreground="{DynamicResource TextDimmed}"
                           FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
