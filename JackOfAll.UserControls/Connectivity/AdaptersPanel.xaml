<UserControl x:Class="JackOfAll.UserControls.Connectivity.AdaptersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:JackOfAll.UserControls.Helpers">
    <UserControl.Resources>
        <ResourceDictionary Source="ConnectivityStyles.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="230"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#34d399" VerticalAlignment="Center" Margin="0,0,5,0"
                                   ToolTip="Download"/>
                        <TextBlock x:Name="DownRate" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" MinWidth="110"/>
                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#3b82f6" VerticalAlignment="Center" Margin="12,0,5,0"
                                   ToolTip="Upload"/>
                        <TextBlock x:Name="UpRate" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" MinWidth="110"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LIVE TRAFFIC, ALL ADAPTERS" Style="{StaticResource SectionLabel}"/>
                        <Button x:Name="BtnPublicIp" Content="Show public IP" Click="OnPublicIpClick" Style="{StaticResource SecondaryButton}"
                                FontSize="11" Padding="8,2" Margin="16,0,0,0" ToolTip="Asks Cloudflare which address the internet sees"/>
                        <TextBox x:Name="PublicIp" Style="{StaticResource Value}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    </StackPanel>
                </DockPanel>
                <h:RateChart x:Name="Chart"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <CheckBox x:Name="ShowDown" DockPanel.Dock="Right" Content="Show disconnected" Checked="OnShowDownChanged" Unchecked="OnShowDownChanged"
                              Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AdaptersHeader" Text="ADAPTERS" Style="{StaticResource SectionLabel}"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AdapterList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBackground}" CornerRadius="6" Padding="14,12" Margin="0,0,10,10" Opacity="{Binding Opacity}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RateText}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border CornerRadius="8" Padding="7,0" Margin="8,0,0,0" Background="{Binding ChipBackground}" VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding ChipForeground}"/>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextDimmed}" FontSize="11" Margin="0,2,0,8"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <ItemsControl ItemsSource="{Binding Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource TextSecondary}" FontSize="11.5"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource Value}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
