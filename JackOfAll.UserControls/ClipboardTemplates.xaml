<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:JackOfAll.UserControls">
    <!-- Shared by the Clipboard tab and the quick picker window. -->

    <!-- One history row: pin bar, icon or thumbnail, title, subtitle and source/time line -->
    <DataTemplate x:Key="ClipRowContent" DataType="{x:Type local:ClipEntry}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,0,10,0"
                    VerticalAlignment="Stretch" Background="{Binding PinBarBrush}"/>

            <Border x:Name="Tile" Grid.Column="1" Width="38" Height="38" CornerRadius="6" Margin="0,0,12,0"
                    VerticalAlignment="Center" ClipToBounds="True"
                    Background="{DynamicResource TabHoverBackground}">
                <Grid>
                    <TextBlock x:Name="GlyphText" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="Thumb" Source="{Binding Thumbnail}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="{DynamicResource AppFontSize}"/>
                <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="{Binding MetaText}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextDimmed}"/>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsText}" Value="True">
                <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="TitleText" Property="FontWeight" Value="Normal"/>
                <Setter TargetName="TitleText" Property="TextWrapping" Value="Wrap"/>
                <Setter TargetName="TitleText" Property="MaxHeight" Value="38"/>
                <Setter TargetName="TitleText" Property="LineHeight" Value="18"/>
                <Setter TargetName="TitleText" Property="FontFamily" Value="Cascadia Code,Consolas,Courier New"/>
                <Setter TargetName="TitleText" Property="FontSize" Value="{DynamicResource MonoFontSize}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsImage}" Value="True">
                <Setter TargetName="Tile" Property="Width" Value="64"/>
                <Setter TargetName="Tile" Property="Height" Value="48"/>
                <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Thumb" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFiles}" Value="True">
                <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource PayloadColor}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLink}" Value="True">
                <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource HeaderColor}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Filter chips (All, Pinned, Text, Images, Files) -->
    <Style x:Key="ClipChip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="13" Padding="12,4" Background="Transparent"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shows an element only for one kind of clip; the preview pane uses it for its three layouts. -->
    <Style x:Key="ForImage" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsImage}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ForFiles" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFiles}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
