<UserControl x:Class="JackOfAll.UserControls.ClipboardHistoryToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header row -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnPause" Click="OnPauseClick" Padding="10,5" Margin="6,0,0,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PauseIcon" Text="&#xE769;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="PauseLabel" Text="Pause" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Click="OnClearAllClick" Padding="10,5" Margin="6,0,0,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource DangerBrush}"
                        BorderBrush="{DynamicResource SurfaceBorder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Clear" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xF0E3;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Clipboard History" Foreground="{DynamicResource TextPrimary}"
                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="CountText" Foreground="{DynamicResource TextDimmed}"
                           FontSize="12" VerticalAlignment="Center" Margin="12,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Search bar (own row) -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged"
                     Padding="32,8,8,8" FontSize="{DynamicResource AppFontSize}"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{DynamicResource TextDimmed}" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock x:Name="SearchPlaceholder" Text="Search clips..."
                       IsHitTestVisible="False" Foreground="{DynamicResource TextDimmed}"
                       VerticalAlignment="Center" Margin="34,0,0,0"
                       FontSize="{DynamicResource AppFontSize}"/>
        </Grid>

        <!-- Clip list -->
        <ListView x:Name="ClipList" Grid.Row="2"
                  Background="Transparent" BorderThickness="0"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionMode="Single"
                  MouseDoubleClick="OnClipDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="Bd" Background="{DynamicResource SurfaceBackground}"
                                        BorderBrush="{DynamicResource SurfaceBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="14,10">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="4"
                                                          Opacity="0.08" Color="Black"/>
                                    </Border.Effect>
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="Bd" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect ShadowDepth="2" BlurRadius="10"
                                                                  Opacity="0.15" Color="Black"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource TabHoverBackground}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pin indicator -->
                        <Border Grid.Column="0" Width="3" CornerRadius="2"
                                Margin="0,0,10,0" VerticalAlignment="Stretch"
                                Background="{Binding PinBarBrush}"/>

                        <!-- Content -->
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis"
                                       MaxHeight="38" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontFamily="Cascadia Code,Consolas,Courier New"
                                       FontSize="{DynamicResource MonoFontSize}"
                                       LineHeight="18"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding TimestampText}"
                                           Foreground="{DynamicResource TextDimmed}" FontSize="11"/>
                                <TextBlock Text="  ·  " Foreground="{DynamicResource TextDimmed}" FontSize="11"/>
                                <TextBlock Text="{Binding SizeText}"
                                           Foreground="{DynamicResource TextDimmed}" FontSize="11"/>
                                <TextBlock Text="{Binding LineCountText}"
                                           Foreground="{DynamicResource TextDimmed}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Action buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Click="OnPinClick" Tag="{Binding}" ToolTip="{Binding PinTooltip}"
                                    Style="{StaticResource IconButton}" Width="32" Height="32" Margin="2,0">
                                <TextBlock Text="{Binding PinGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{Binding PinForeground}"/>
                            </Button>
                            <Button Click="OnCopyClick" Tag="{Binding}" ToolTip="Copy to clipboard"
                                    Style="{StaticResource IconButton}" Width="32" Height="32" Margin="2,0">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                            </Button>
                            <Button Click="OnDeleteClick" Tag="{Binding}" ToolTip="Remove from history"
                                    Style="{StaticResource IconButton}" Width="32" Height="32" Margin="2,0">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status bar -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Border CornerRadius="4" Padding="10,6"
                    Background="{DynamicResource SurfaceBackground}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="MonitorDot" Width="7" Height="7" Margin="0,0,8,0"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Monitoring clipboard. Double-click an entry to copy."
                               Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
