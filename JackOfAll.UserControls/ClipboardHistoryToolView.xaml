<UserControl x:Class="JackOfAll.UserControls.ClipboardHistoryToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:JackOfAll.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary Source="/JackOfAll.UserControls;component/ClipboardTemplates.xaml"/>
    </UserControl.Resources>
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header row -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnPicker" Click="OnPickerClick" Padding="10,5" Margin="6,0,0,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Quick picker" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnPause" Click="OnPauseClick" Padding="10,5" Margin="6,0,0,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PauseIcon" Text="&#xE769;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="PauseLabel" Text="Pause" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Click="OnClearAllClick" Padding="10,5" Margin="6,0,0,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource DangerBrush}"
                        BorderBrush="{DynamicResource SurfaceBorder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Clear" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xF0E3;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Clipboard History" Foreground="{DynamicResource TextPrimary}"
                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="CountText" Foreground="{DynamicResource TextDimmed}"
                           FontSize="12" VerticalAlignment="Center" Margin="12,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Search bar (own row) -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"
                     Padding="32,8,8,8" FontSize="{DynamicResource AppFontSize}"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{DynamicResource TextDimmed}" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock x:Name="SearchPlaceholder" Text="Search text, the words in images, file names and apps..."
                       IsHitTestVisible="False" Foreground="{DynamicResource TextDimmed}"
                       VerticalAlignment="Center" Margin="34,0,0,0"
                       FontSize="{DynamicResource AppFontSize}"/>
        </Grid>

        <!-- Filters -->
        <StackPanel x:Name="FilterBar" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton Content="All" Tag="{x:Static local:ClipFilter.All}" IsChecked="True"
                         GroupName="ClipFilter" Style="{StaticResource ClipChip}" Checked="OnFilterChecked"/>
            <RadioButton Content="Pinned" Tag="{x:Static local:ClipFilter.Pinned}"
                         GroupName="ClipFilter" Style="{StaticResource ClipChip}" Checked="OnFilterChecked"/>
            <RadioButton Content="Text" Tag="{x:Static local:ClipFilter.Text}"
                         GroupName="ClipFilter" Style="{StaticResource ClipChip}" Checked="OnFilterChecked"/>
            <RadioButton Content="Images" Tag="{x:Static local:ClipFilter.Images}"
                         GroupName="ClipFilter" Style="{StaticResource ClipChip}" Checked="OnFilterChecked"/>
            <RadioButton Content="Files" Tag="{x:Static local:ClipFilter.Files}"
                         GroupName="ClipFilter" Style="{StaticResource ClipChip}" Checked="OnFilterChecked"/>
        </StackPanel>

        <!-- Clip list and preview -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="360" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="ClipList" Grid.Column="0"
                      Background="Transparent" BorderThickness="0"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionMode="Single"
                      SelectionChanged="OnSelectionChanged"
                      PreviewKeyDown="OnListKeyDown"
                      MouseDoubleClick="OnClipDoubleClick">
                <ListView.ContextMenu>
                    <ContextMenu Opened="OnMenuOpened">
                        <MenuItem x:Name="MenuCopy" Header="Copy" InputGestureText="Enter" Click="OnMenuCopy"/>
                        <MenuItem x:Name="MenuCopyPlain" Header="Copy as plain text" InputGestureText="Shift+Enter" Click="OnMenuCopyPlain"/>
                        <MenuItem x:Name="MenuShowFolder" Header="Show in folder" Click="OnMenuShowFolder"/>
                        <MenuItem x:Name="MenuOpenImage" Header="Open image" Click="OnMenuOpenImage"/>
                        <MenuItem x:Name="MenuPin" Header="Pin" InputGestureText="Ctrl+P" Click="OnMenuPin"/>
                        <Separator/>
                        <MenuItem Header="Delete" InputGestureText="Del" Click="OnMenuDelete"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd" Background="{DynamicResource SurfaceBackground}"
                                            BorderBrush="{DynamicResource SurfaceBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="1" BlurRadius="4"
                                                              Opacity="0.08" Color="Black"/>
                                        </Border.Effect>
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Bd" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect ShadowDepth="2" BlurRadius="10"
                                                                      Opacity="0.15" Color="Black"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource TabHoverBackground}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0" Content="{Binding}" Margin="0,0,10,0"
                                              ContentTemplate="{StaticResource ClipRowContent}"/>

                            <!-- Action buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="OnPinClick" Tag="{Binding}" ToolTip="{Binding PinTooltip}"
                                        Style="{StaticResource IconButton}" Width="32" Height="32" Margin="2,0">
                                    <TextBlock Text="{Binding PinGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{Binding PinForeground}"/>
                                </Button>
                                <Button Click="OnCopyClick" Tag="{Binding}" ToolTip="Copy to clipboard"
                                        Style="{StaticResource IconButton}" Width="32" Height="32" Margin="2,0">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                                <Button Click="OnDeleteClick" Tag="{Binding}" ToolTip="Remove from history"
                                        Style="{StaticResource IconButton}" Width="32" Height="32" Margin="2,0">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyText" Grid.Column="0" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                       Foreground="{DynamicResource TextSecondary}"/>

            <local:ClipPreview x:Name="Preview" Grid.Column="2"/>
        </Grid>

        <!-- Status bar -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="HintText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="12" Foreground="{DynamicResource TextDimmed}"/>
            <Border CornerRadius="4" Padding="10,6" HorizontalAlignment="Left"
                    Background="{DynamicResource SurfaceBackground}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="MonitorDot" Width="7" Height="7" Margin="0,0,8,0"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Recording the clipboard. Double-click an entry to copy."
                               Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
