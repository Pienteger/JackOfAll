<UserControl x:Class="JackOfAll.UserControls.EnvVarToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Refresh" Click="OnRefreshClick" Padding="10,4" Margin="4,0,0,0"
                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                <Button Content="Copy Selected" Click="OnCopySelectedClick" Padding="10,4" Margin="4,0,0,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}"/>
                <ComboBox x:Name="ScopeFilter" SelectionChanged="OnScopeChanged" Padding="6,4" Margin="4,0,0,0"
                          Background="{DynamicResource SurfaceBackground}"
                          Foreground="{DynamicResource TextPrimary}"
                          BorderBrush="{DynamicResource SurfaceBorder}">
                    <ComboBoxItem Content="All Scopes" IsSelected="True"/>
                    <ComboBoxItem Content="Process"/>
                    <ComboBoxItem Content="User"/>
                    <ComboBoxItem Content="Machine"/>
                </ComboBox>
            </StackPanel>
            <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged"
                     Background="{DynamicResource SurfaceBackground}"
                     Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource SurfaceBorder}"
                     Padding="6,4" VerticalAlignment="Center" MaxWidth="300" HorizontalAlignment="Left">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Resources>
                            <VisualBrush x:Key="HintBrush" TileMode="None" Stretch="None" AlignmentX="Left">
                                <VisualBrush.Visual>
                                    <TextBlock Text="Search variables..." FontStyle="Italic"
                                               Foreground="{DynamicResource TextDimmed}" Margin="6,0,0,0"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Style.Resources>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DockPanel>

        <!-- Data Grid -->
        <DataGrid x:Name="EnvGrid" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single" CanUserSortColumns="True"
                  Background="{DynamicResource SurfaceBackground}"
                  Foreground="{DynamicResource TextPrimary}"
                  BorderBrush="{DynamicResource SurfaceBorder}"
                  RowBackground="{DynamicResource SurfaceBackground}"
                  AlternatingRowBackground="{DynamicResource AppBackground}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource SurfaceBorder}"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="250">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource HeaderColor}"/>
                            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Courier New"/>
                            <Setter Property="FontSize" Value="{DynamicResource MonoFontSize}"/>
                            <Setter Property="Padding" Value="6,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Courier New"/>
                            <Setter Property="FontSize" Value="{DynamicResource MonoFontSize}"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Scope" Binding="{Binding Target}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Setter Property="Padding" Value="6,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Border CornerRadius="4" Padding="8,4" Background="{DynamicResource SurfaceBackground}">
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
