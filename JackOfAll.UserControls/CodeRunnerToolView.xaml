<UserControl x:Class="JackOfAll.UserControls.CodeRunnerToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Click="OnNewFileClick" Padding="10,4" Margin="4,0,0,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="New" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnSaveClick" Padding="10,4" Margin="4,0,0,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Save" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnRunClick" Padding="14,5" Margin="4,0,0,0"
                        Style="{StaticResource PrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Run" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <ComboBox x:Name="LanguagePicker" Width="140" FontSize="13"
                          Background="{DynamicResource SurfaceBackground}"
                          Foreground="{DynamicResource TextPrimary}"
                          BorderBrush="{DynamicResource SurfaceBorder}"
                          SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem Content="C#" Tag="csharp" IsSelected="True"/>
                    <ComboBoxItem Content="JavaScript" Tag="javascript"/>
                    <ComboBoxItem Content="Python" Tag="python"/>
                </ComboBox>
                <TextBlock x:Name="RuntimeLabel" Text="dotnet run" FontSize="11"
                           Foreground="{DynamicResource TextDimmed}" VerticalAlignment="Center"
                           Margin="10,0,0,0" FontFamily="Cascadia Code,Consolas,Courier New"/>
                <TextBlock Text="·" Foreground="{DynamicResource TextDimmed}" VerticalAlignment="Center"
                           Margin="10,0,10,0" FontSize="14"/>
                <TextBlock x:Name="FileTitle" Text="untitled" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" FontSize="12"
                           FontFamily="Cascadia Code,Consolas,Courier New"/>
            </StackPanel>
        </DockPanel>

        <!-- Content area: file panel + editor -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilePanelColumn" Width="0"/>
                <ColumnDefinition x:Name="FilePanelSplitterColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- File panel (visible when environment active) -->
            <Border x:Name="FilePanel" Grid.Column="0" Visibility="Collapsed"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="8,8,8,4">
                        <Button DockPanel.Dock="Right" Click="OnRefreshFiles" Padding="4,2" ToolTip="Refresh"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextSecondary}">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Click="OnNewFileClick" Padding="4,2" ToolTip="New File"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextSecondary}" Margin="0,0,4,0">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Click="OnOpenFolderClick" Padding="4,2"
                                ToolTip="open in explorer" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextSecondary}" Margin="0,0,4,0">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <TextBlock Text="Files" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBox x:Name="FileSearchBox" Grid.Row="1" Margin="8,2,8,6"
                             Padding="6,4" FontSize="11"
                             Background="{DynamicResource AppBackground}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource SurfaceBorder}"
                             ToolTip="Search files"
                             TextChanged="OnFileSearchChanged"/>

                    <ListBox x:Name="FileList" Grid.Row="2" Margin="4,0,4,4"
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="OnFileSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename" Click="OnRenameFileClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Delete" Click="OnDeleteFileClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,3">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{DynamicResource TextDimmed}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True"/>

            <!-- Code editor (AvalonEdit) -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                    CornerRadius="6" ClipToBounds="True">
                <avalonEdit:TextEditor x:Name="CodeEditor"
                                       ShowLineNumbers="True"
                                       WordWrap="False"
                                       Background="{DynamicResource AppBackground}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontFamily="Cascadia Code,Consolas,Courier New"
                                       FontSize="{DynamicResource EditorFontSize}"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"
                                       Padding="8,4"
                                       PreviewMouseWheel="OnEditorMouseWheel"/>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Margin="0,8,0,0" CornerRadius="4" Padding="8,4"
                Background="{DynamicResource SurfaceBackground}">
            <TextBlock x:Name="StatusText" Text="F5 or Run to execute" FontSize="11"
                       Foreground="{DynamicResource TextDimmed}"
                       FontFamily="Cascadia Code,Consolas,Courier New"/>
        </Border>
    </Grid>
</UserControl>
