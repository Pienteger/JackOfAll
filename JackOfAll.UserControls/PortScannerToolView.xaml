<UserControl x:Class="JackOfAll.UserControls.PortScannerToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnListActive" Click="OnListActiveClick" Padding="10,4" Margin="4,0,0,0"
                        Style="{StaticResource PrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="List Active" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnScanCommon" Click="OnScanCommonClick" Padding="10,4" Margin="4,0,0,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Scan Common" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnScanRange" Click="OnScanRangeClick" Padding="10,4" Margin="4,0,0,0"
                        Background="{DynamicResource SurfaceBackground}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource SurfaceBorder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Scan Range" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBox x:Name="RangeStart" Text="1" Width="60" Padding="4,4" Margin="8,0,0,0"
                         Background="{DynamicResource SurfaceBackground}"
                         Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource SurfaceBorder}" VerticalAlignment="Center"/>
                <TextBlock Text="-" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                <TextBox x:Name="RangeEnd" Text="1024" Width="60" Padding="4,4"
                         Background="{DynamicResource SurfaceBackground}"
                         Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource SurfaceBorder}" VerticalAlignment="Center"/>
                <Button x:Name="BtnCancel" Click="OnCancelClick" Padding="10,4" Margin="8,0,0,0"
                        Style="{StaticResource DangerButton}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="Port Scanner (localhost)" Foreground="{DynamicResource TextPrimary}"
                       FontSize="{DynamicResource AppFontSize}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Results -->
        <DataGrid x:Name="PortGrid" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  Background="{DynamicResource SurfaceBackground}"
                  Foreground="{DynamicResource TextPrimary}"
                  BorderBrush="{DynamicResource SurfaceBorder}"
                  RowBackground="{DynamicResource SurfaceBackground}"
                  AlternatingRowBackground="{DynamicResource AppBackground}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource SurfaceBorder}"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource HeaderColor}"/>
                            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Courier New"/>
                            <Setter Property="FontSize" Value="{DynamicResource MonoFontSize}"/>
                            <Setter Property="Padding" Value="6,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource PayloadColor}"/>
                            <Setter Property="Padding" Value="6,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Setter Property="Padding" Value="6,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Courier New"/>
                            <Setter Property="FontSize" Value="{DynamicResource MonoFontSize}"/>
                            <Setter Property="Padding" Value="6,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="Padding" Value="6,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Kill" Click="OnKillClick" Tag="{Binding Pid}"
                                    Padding="8,2" Background="{DynamicResource SurfaceBackground}"
                                    Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1" FontSize="11" Cursor="Hand"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Pid}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Empty state -->
        <TextBlock Grid.Row="1"
           Text="Run a scan to see results"
                   Foreground="{DynamicResource TextDimmed}"
                   FontStyle="Italic"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>

                    <Style.Triggers>
                        <!-- null ItemsSource -->
                        <DataTrigger Binding="{Binding ElementName=PortGrid, Path=ItemsSource}"
                             Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>

                        <!-- empty collection -->
                        <DataTrigger Binding="{Binding ElementName=PortGrid, Path=Items.Count}"
                             Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Status bar -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Border CornerRadius="4" Padding="8,4" Background="{DynamicResource SurfaceBackground}">
                <TextBlock x:Name="StatusText" Text="Click 'List Active' to see listening ports."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
