<UserControl x:Class="JackOfAll.UserControls.HushToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="clr-namespace:JackOfAll.UserControls.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <TextBlock Text="HUSH" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Text="Rain, waves, fire and noise for focus and sleep, synthesized live on your PC. Not a single recording."
                       FontSize="12" Foreground="{DynamicResource TextDimmed}" Margin="0,2,0,12" TextWrapping="Wrap"/>

            <Border Height="120" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="1" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,16">
                <Grid>
                    <h:HushVisualizer x:Name="Viz"/>
                    <TextBlock x:Name="VizHint" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic"
                               Foreground="{DynamicResource TextDimmed}" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <UniformGrid x:Name="TileGrid" Columns="5" Margin="0,0,-10,0"/>

            <TextBlock Text="MIXES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,8"/>
            <WrapPanel x:Name="MixPanel"/>

            <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,10,0,0">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnPlay" DockPanel.Dock="Left" Click="OnPlayClick" Style="{StaticResource PrimaryButton}"
                            Padding="16,6" ToolTip="Play or pause (Space)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="PlayLabel" Text="Play" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock DockPanel.Dock="Left" Text="Volume" VerticalAlignment="Center" Margin="20,0,8,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <Slider x:Name="MasterSlider" DockPanel.Dock="Left" Width="180" Minimum="0" Maximum="1"
                            VerticalAlignment="Center" ValueChanged="OnMasterChanged"/>
                    <TextBlock x:Name="MasterText" DockPanel.Dock="Left" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <Button x:Name="BtnTimer" DockPanel.Dock="Left" Click="OnTimerClick" MouseRightButtonUp="OnTimerRightClick"
                            Padding="10,5" Margin="16,0,0,0"
                            Background="{DynamicResource AppBackground}"
                            Foreground="{DynamicResource TextPrimary}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            ToolTip="Sleep timer: click to cycle, right-click to go back (T). Fades out over the last minute.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TimerLabel" Text="Sleep timer: off" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="StatusText" TextAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
