<UserControl x:Class="JackOfAll.UserControls.TallyToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="980">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="TALLY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Text="Where your time went. Records the window in front and stops counting when you go idle. Runs by itself and stays on this PC."
                       FontSize="12" Foreground="{DynamicResource TextDimmed}" Margin="0,2,0,12" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE76B;" Click="OnPrevClick" ToolTip="Previous day / week (Left)"/>
            <TextBlock x:Name="DateLabel" DockPanel.Dock="Left" Width="190" TextAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE76C;" Click="OnNextClick" ToolTip="Next day / week (Right)"/>
            <Button DockPanel.Dock="Left" Content="Today" Click="OnTodayClick" Padding="10,4" Margin="6,0,0,0"
                    Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource SurfaceBorder}"/>
            <TextBlock DockPanel.Dock="Left" Text="Group by" VerticalAlignment="Center" Margin="20,0,8,0"
                       Foreground="{DynamicResource TextSecondary}"/>
            <ComboBox x:Name="GroupBox" DockPanel.Dock="Left" Width="130" SelectionChanged="OnGroupChanged"/>
            <Button x:Name="BtnForget" DockPanel.Dock="Right" Click="OnForgetClick" Padding="10,4" Margin="8,0,0,0"
                    Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource SurfaceBorder}" ToolTip="Delete what Tally recorded on this day">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Forget this day" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="TotalText" TextAlignment="Right" VerticalAlignment="Center"
                       FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
        </DockPanel>

        <TabControl Grid.Row="2" x:Name="Tabs" Background="{DynamicResource AppBackground}" BorderThickness="0" Padding="0"
                    SelectionChanged="OnTabChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource InnerTabItem}"/>
            </TabControl.Resources>

            <TabItem Header="Day">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <Canvas x:Name="Timeline" Height="34" ClipToBounds="True" SizeChanged="OnTimelineSized" Background="Transparent"/>
                            <Grid x:Name="HourAxis" Height="16" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="TotalsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="22">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Brush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="NameColumn" Header="App" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="90" SortMemberPath="Seconds"/>
                            <DataGridTemplateColumn Header="Share" Width="220" SortMemberPath="Seconds">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ShareText}" Width="44" TextAlignment="Right"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                            <Grid Height="6" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource SurfaceBorder}" CornerRadius="3"/>
                                                <Border Background="{Binding Brush}" CornerRadius="3" HorizontalAlignment="Left"
                                                        Width="{Binding BarWidth}"/>
                                            </Grid>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Week">
                <DataGrid x:Name="WeekGrid" Margin="0,10,0,0" AutoGenerateColumns="True" IsReadOnly="True"
                          SelectionMode="Single" CanUserSortColumns="False" AutoGeneratingColumn="OnWeekColumn"/>
            </TabItem>

            <TabItem Header="Projects">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondary}"
                               Text="Rules put activity into projects. The first rule whose text appears in the app name or the window title wins; everything else is &quot;(no project)&quot;. Group by Project to see the result."/>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Save rules" Click="OnSaveRulesClick" Style="{StaticResource PrimaryButton}" Padding="14,5"/>
                        <Button DockPanel.Dock="Right" Content="+ Add rule" Click="OnAddRuleClick" Padding="10,5" Margin="0,0,8,0"
                                Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}"
                                BorderBrush="{DynamicResource SurfaceBorder}"/>
                        <TextBlock x:Name="RulesStatus" VerticalAlignment="Center" Foreground="{DynamicResource TextDimmed}"/>
                    </DockPanel>
                    <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Project" Binding="{Binding Project, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                            <DataGridComboBoxColumn x:Name="FieldColumn" Header="Look in" SelectedItemBinding="{Binding Field}" Width="140"/>
                            <DataGridTextColumn Header="Contains" Binding="{Binding Contains, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextDimmed}"/>
    </Grid>
</UserControl>
