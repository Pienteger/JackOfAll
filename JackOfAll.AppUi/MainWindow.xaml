<Window x:Class="JackOfAll.AppUi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="JackOfAll" Height="700" Width="1100"
        Background="{DynamicResource AppBackground}"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app-icon.png">
    <Window.InputBindings>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding NewTabCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding SettingsCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl+Shift" Command="{Binding RestoreTabCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Accent gradient strip (animated) -->
        <Border x:Name="AccentStrip" Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                    <LinearGradientBrush.RelativeTransform>
                        <TranslateTransform x:Name="GradientShift" X="0"/>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#6366f1" Offset="0"/>
                    <GradientStop Color="#a855f7" Offset="0.2"/>
                    <GradientStop Color="#ec4899" Offset="0.4"/>
                    <GradientStop Color="#f97316" Offset="0.6"/>
                    <GradientStop Color="#eab308" Offset="0.8"/>
                    <GradientStop Color="#6366f1" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="GradientShift"
                                             Storyboard.TargetProperty="X"
                                             From="0" To="1"
                                             Duration="0:0:10"
                                             RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
        </Border>

        <!-- Tab bar -->
        <Border Grid.Row="1" Background="{DynamicResource TabBarBackground}"
                BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Settings button -->
                <Button DockPanel.Dock="Right" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                        Width="36" Height="32" Margin="4,2"
                        Click="OnSettingsClick"
                        Background="Transparent" Foreground="{DynamicResource TextSecondary}"
                        BorderThickness="0" Cursor="Hand"
                        ToolTip="Settings (Ctrl+,)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBackground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Archived tabs button -->
                <Button x:Name="ArchivedBtn" DockPanel.Dock="Right" Content="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                        Width="36" Height="32" Margin="4,2" Visibility="Collapsed"
                        Click="OnArchivedClick"
                        Background="Transparent" Foreground="{DynamicResource TextSecondary}"
                        BorderThickness="0" Cursor="Hand"
                        ToolTip="Archived tabs">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBackground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ArchivedMenu"/>
                    </Button.ContextMenu>
                </Button>

                <!-- Environment dropdown -->
                <Border DockPanel.Dock="Right" Margin="4,2" VerticalAlignment="Center">
                    <ComboBox x:Name="EnvCombo" Width="150" FontSize="11"
                              SelectionChanged="OnEnvironmentChanged"
                              Background="{DynamicResource SurfaceBackground}"
                              Foreground="{DynamicResource TextPrimary}"
                              BorderBrush="{DynamicResource SurfaceBorder}"/>
                </Border>

                <!-- New tab button -->
                <Button DockPanel.Dock="Right" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                        Width="36" Height="32" Margin="4,2"
                        Click="OnNewTabClick"
                        Background="Transparent" Foreground="{DynamicResource TextSecondary}"
                        BorderThickness="0" Cursor="Hand"
                        ToolTip="New tab (Ctrl+T)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBackground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Tab list -->
                <ListBox x:Name="TabList" DockPanel.Dock="Left"
                         SelectionChanged="OnTabSelectionChanged"
                         Background="Transparent" BorderThickness="0"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="OnTabMouseDown"
                         PreviewMouseMove="OnTabMouseMove"
                         Drop="OnTabDrop"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="AllowDrop" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{DynamicResource TabBarBackground}"
                                                BorderBrush="Transparent"
                                                BorderThickness="0,2,0,0" Padding="0" MinWidth="100"
                                                Margin="1,0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabActiveBackground}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBackground}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="8,6" MouseLeftButtonDown="OnTabHeaderDoubleClick">
                                <DockPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename" Click="OnRenameTab" Tag="{Binding Id}"/>
                                        <MenuItem Header="{Binding PinMenuText}" Click="OnPinTab" Tag="{Binding Id}"/>
                                        <MenuItem Header="Duplicate" Click="OnDuplicateTab" Tag="{Binding Id}"/>
                                        <Separator/>
                                        <MenuItem Header="Split Right" Click="OnSplitRight" Tag="{Binding Id}"/>
                                        <MenuItem Header="Split Down" Click="OnSplitDown" Tag="{Binding Id}"/>
                                        <Separator/>
                                        <MenuItem Header="Archive" Click="OnArchiveTab" Tag="{Binding Id}"/>
                                        <Separator/>
                                        <MenuItem Header="Close" Click="OnCloseTabClick" Tag="{Binding Id}"/>
                                        <MenuItem Header="Close Others" Click="OnCloseOtherTabs" Tag="{Binding Id}"/>
                                        <MenuItem Header="Close Tabs to the Right" Click="OnCloseTabsRight" Tag="{Binding Id}"/>
                                    </ContextMenu>
                                </DockPanel.ContextMenu>

                                <!-- Pin indicator -->
                                <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           VerticalAlignment="Center" Margin="0,0,4,0"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"
                                           DockPanel.Dock="Left"/>

                                <!-- Close button -->
                                <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                        Click="OnCloseTabClick" Tag="{Binding Id}"
                                        Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}"
                                        Background="Transparent" Foreground="{DynamicResource TextDimmed}" BorderThickness="0"
                                        Cursor="Hand" Margin="8,0,0,0" Padding="2"
                                        VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="3,1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#ef4444"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Title (display) -->
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MaxWidth="150"
                                           Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}"/>

                                <!-- Title (editing) -->
                                <TextBox x:Name="RenameBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" MaxWidth="150" VerticalAlignment="Center"
                                         Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                         Background="{DynamicResource SurfaceBackground}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         BorderBrush="{DynamicResource AccentBrush}"
                                         LostFocus="OnRenameBoxLostFocus"
                                         KeyDown="OnRenameBoxKeyDown"
                                         Loaded="OnRenameBoxLoaded"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <ContentControl Grid.Row="2" x:Name="ContentArea"/>
    </Grid>
</Window>
