<Window x:Class="JackOfAll.AppUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="720" Height="520"
        MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}"
        Icon="Assets/app-icon.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left navigation panel -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App branding at top -->
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,16">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/app-icon.png" Width="28" Height="28"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Separator DockPanel.Dock="Top" Background="{DynamicResource SurfaceBorder}" Margin="12,0,12,8"/>

                <!-- Version at bottom -->
                <TextBlock DockPanel.Dock="Bottom" x:Name="VersionLabel" FontSize="11"
                           Foreground="{DynamicResource TextDimmed}" Margin="16,0,16,16"
                           VerticalAlignment="Bottom"/>

                <!-- Nav items -->
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnNavChanged" Margin="8,4,8,0"
                         SelectedIndex="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                                CornerRadius="6" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource TabHoverBackground}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource TabHoverBackground}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextPrimary}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Appearance"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA35;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Editor"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Auto Save"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="About"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0">
            <Grid Margin="28,24,28,24">
                <!-- Appearance Page -->
                <StackPanel x:Name="PageAppearance">
                    <TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Customize how JackOfAll looks" FontSize="13"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,20"/>

                    <Border Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Theme Mode -->
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Theme" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Choose your preferred color scheme" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="ThemeCombo" DockPanel.Dock="Right" Width="140"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          SelectionChanged="OnThemeChanged"
                                          Background="{DynamicResource SurfaceBackground}"
                                          Foreground="{DynamicResource TextPrimary}"
                                          BorderBrush="{DynamicResource SurfaceBorder}">
                                    <ComboBoxItem Content="Dark" Tag="Dark"/>
                                    <ComboBoxItem Content="Light" Tag="Light"/>
                                    <ComboBoxItem Content="System" Tag="System"/>
                                </ComboBox>
                            </DockPanel>

                            <Separator Background="{DynamicResource SurfaceBorder}" Margin="0,16"/>

                            <!-- UI Font Size -->
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="UI Font Size" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Labels, buttons, and navigation" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock x:Name="FontSizeLabel" FontSize="14" MinWidth="30"
                                               TextAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0"/>
                                    <Slider x:Name="FontSizeSlider" Width="140" Minimum="10" Maximum="24"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="OnFontSizeChanged" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Preview -->
                    <TextBlock Text="PREVIEW" FontSize="11" FontWeight="SemiBold"                               Foreground="{DynamicResource TextDimmed}" Margin="0,8,0,8"/>

                    <Border Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock x:Name="PreviewNormal" Text="The quick brown fox jumps over the lazy dog."
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="PreviewMono" Text="{}{&quot;preview&quot;: &quot;monospace&quot;}"
                                       FontFamily="Cascadia Code,Consolas,Courier New"
                                       Foreground="{DynamicResource HeaderColor}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="PreviewSecondary" Text="Secondary text appears like this."
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Editor Page -->
                <StackPanel x:Name="PageEditor" Visibility="Collapsed">
                    <TextBlock Text="Editor" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Configure text and code editor behavior" FontSize="13"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,20"/>

                    <Border Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <!-- Editor Font Size -->
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Font Size" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Code and text editors (Ctrl+Scroll to adjust)" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock x:Name="EditorFontSizeLabel" FontSize="14" MinWidth="30"
                                               TextAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0"/>
                                    <Slider x:Name="EditorFontSizeSlider" Width="140" Minimum="10" Maximum="32"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="OnEditorFontSizeChanged" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Editor Preview -->
                    <TextBlock Text="PREVIEW" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDimmed}" Margin="0,20,0,8"/>

                    <Border Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <TextBlock x:Name="PreviewEditor" Text="Editor text preview — Ctrl+Scroll to zoom"
                                   FontFamily="Cascadia Code,Consolas,Courier New"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </Border>
                </StackPanel>

                <!-- Auto Save Page -->
                <StackPanel x:Name="PageAutoSave" Visibility="Collapsed">
                    <TextBlock Text="Auto Save" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Automatically save files after changes" FontSize="13"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,20"/>

                    <Border Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <!-- Auto Save Mode -->
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Auto Save" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="When to save files automatically" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="AutoSaveCombo" DockPanel.Dock="Right" Width="160"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          SelectionChanged="OnAutoSaveModeChanged"
                                          Background="{DynamicResource SurfaceBackground}"
                                          Foreground="{DynamicResource TextPrimary}"
                                          BorderBrush="{DynamicResource SurfaceBorder}">
                                    <ComboBoxItem Content="Off" Tag="Off"/>
                                    <ComboBoxItem Content="After Delay" Tag="AfterDelay"/>
                                    <ComboBoxItem Content="On Focus Change" Tag="OnFocusChange"/>
                                </ComboBox>
                            </DockPanel>

                            <Separator x:Name="AutoSaveDelaySeparator" Background="{DynamicResource SurfaceBorder}" Margin="0,16"/>

                            <!-- Auto Save Delay -->
                            <DockPanel x:Name="AutoSaveDelayPanel">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Delay" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Milliseconds after last edit before saving" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock x:Name="AutoSaveDelayLabel" FontSize="14" MinWidth="50"
                                               TextAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0"/>
                                    <Slider x:Name="AutoSaveDelaySlider" Width="140" Minimum="200" Maximum="5000"
                                            TickFrequency="100" IsSnapToTickEnabled="True"
                                            ValueChanged="OnAutoSaveDelayChanged" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Info callout -->
                    <Border Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextDimmed}" VerticalAlignment="Top"
                                       Margin="0,2,10,0"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}">
                                <Run FontWeight="SemiBold" Text="After Delay"/><Run Text=" saves automatically after you stop typing. "/><Run FontWeight="SemiBold" Text="On Focus Change"/><Run Text=" saves when you switch to another file or tool. Auto-save only applies to files that have been saved at least once."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- About Page -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Text="About" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Application information" FontSize="13"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,20"/>

                    <Border Background="{DynamicResource SurfaceBackground}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="24">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Image Source="Assets/app-icon.png" Width="48" Height="48"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="JackOfAll" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="A developer toolbox for everyday tasks."
                                               FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Separator Background="{DynamicResource SurfaceBorder}" Margin="0,0,0,16"/>

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Version" FontSize="13" Width="80"
                                           Foreground="{DynamicResource TextDimmed}"/>
                                <TextBlock x:Name="AboutVersionLabel" FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Author" FontSize="13" Width="80"
                                           Foreground="{DynamicResource TextDimmed}"/>
                                <TextBlock Text="Mahmudul Hasan" FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Website" FontSize="13" Width="80"
                                           Foreground="{DynamicResource TextDimmed}"/>
                                <TextBlock FontSize="13">
                                    <Hyperlink x:Name="WebsiteLink" Click="OnWebsiteLinkClick"
                                               Foreground="{DynamicResource AccentBrush}">
                                        mahmudx.com
                                    </Hyperlink>
                                </TextBlock>
                            </DockPanel>

                            <DockPanel>
                                <TextBlock Text="GitHub" FontSize="13" Width="80"
                                           Foreground="{DynamicResource TextDimmed}"/>
                                <TextBlock FontSize="13">
                                    <Hyperlink x:Name="GitHubLink" Click="OnGitHubLinkClick"
                                               Foreground="{DynamicResource AccentBrush}">
                                        github.com/mahmudx
                                    </Hyperlink>
                                </TextBlock>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
