<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<StartupObject>JackOfAll.AppUi.App</StartupObject>
		<AssemblyTitle>JackOfAll</AssemblyTitle>
		<Version>1.0.0</Version>
		<ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="Assets\app-icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\app-icon.png" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\JackOfAll.CustomControls\JackOfAll.CustomControls.csproj" />
		<ProjectReference Include="..\JackOfAll.Lib\JackOfAll.Lib.csproj" />
		<ProjectReference Include="..\JackOfAll.UserControls\JackOfAll.UserControls.csproj" />
	</ItemGroup>
</Project>
