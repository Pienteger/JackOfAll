<Application x:Class="JackOfAll.AppUi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:JackOfAll.AppUi">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Theme resources (defaults — overridden by ThemeManager at startup) -->
        <SolidColorBrush x:Key="AppBackground" Color="#1e1e1e"/>
        <SolidColorBrush x:Key="SurfaceBackground" Color="#2d2d30"/>
        <SolidColorBrush x:Key="SurfaceBorder" Color="#3e3e42"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#cccccc"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#999999"/>
        <SolidColorBrush x:Key="TextDimmed" Color="#666666"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007acc"/>
        <SolidColorBrush x:Key="TabBarBackground" Color="#2d2d30"/>
        <SolidColorBrush x:Key="TabActiveBackground" Color="#1e1e1e"/>
        <SolidColorBrush x:Key="TabHoverBackground" Color="#383838"/>
        <SolidColorBrush x:Key="GridAltRow" Color="#252526"/>
        <SolidColorBrush x:Key="ErrorBackground" Color="#3a1d1d"/>
        <SolidColorBrush x:Key="ErrorBorder" Color="#d32f2f"/>
        <SolidColorBrush x:Key="ErrorText" Color="#ef9a9a"/>
        <SolidColorBrush x:Key="SuccessBackground" Color="#1d3a1d"/>
        <SolidColorBrush x:Key="SuccessText" Color="#81c784"/>
        <SolidColorBrush x:Key="HeaderColor" Color="#4ec9b0"/>
        <SolidColorBrush x:Key="PayloadColor" Color="#dcdcaa"/>
        <sys:Double x:Key="AppFontSize">13</sys:Double>
        <sys:Double x:Key="MonoFontSize">12</sys:Double>
    </Application.Resources>
</Application>
